[Unit]
Description=Covalence: iCloud Drive in Files (rclone mount)
Documentation=file://@PKGDATADIR@/guide/en/09-apple.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=notify
# Defaults; Covalence's iCloud Drive options write their own values in drive.env.
Environment="COVALENCE_DRIVE_DIR=%h/iCloud Drive"
Environment=RCLONE_VFS_CACHE_MODE=full
Environment=RCLONE_VFS_CACHE_MAX_SIZE=5G
Environment=RCLONE_VFS_CACHE_MAX_AGE=168h
Environment=RCLONE_DIR_CACHE_TIME=5m
Environment=RCLONE_READ_ONLY=false
Environment=RCLONE_BWLIMIT=off
EnvironmentFile=-%h/.config/covalence/drive.env
ExecStartPre=/usr/bin/mkdir -p "${COVALENCE_DRIVE_DIR}"
# Private rc socket (runtime dir, this user only): Covalence reads the upload counters
# there to show the sync state in Files. Nothing is changed through it.
ExecStartPre=/usr/bin/mkdir -p -m 0700 %t/covalence
ExecStartPre=/usr/bin/rm -f %t/covalence/drive-rc.sock
# The config is encrypted; its key comes from the keyring through secret-tool.
ExecStart=@BINDIR@/covalence-rclone mount icloud: "${COVALENCE_DRIVE_DIR}" \
    --config %h/.config/covalence/rclone.conf \
    --password-command "secret-tool lookup application io.github.melvincouwez.Covalence kind rclone-config" \
    --ask-password=false --volname "iCloud Drive" \
    --rc --rc-addr unix://%t/covalence/drive-rc.sock --rc-no-auth
ExecStop=/usr/bin/fusermount3 -uz "${COVALENCE_DRIVE_DIR}"
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical-session.target
