[Desktop Entry]
Type=Application
Name=Contacts
Name[fr]=Contacts
GenericName=Phone Contacts
GenericName[fr]=Contacts du téléphone
Comment=Browse contacts from your iPhone, call or write to them
Comment[fr]=Parcourir les contacts de l'iPhone, les appeler ou leur écrire
Exec=@BINDIR@/@APP_ID@.Contacts
Icon=@APP_ID@.Contacts
Terminal=false
Categories=Office;ContactManagement;GTK;
Keywords=contacts;address book;iPhone;phone;
Keywords[fr]=contacts;carnet d'adresses;iPhone;téléphone;
StartupNotify=true
