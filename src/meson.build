config_vala = configure_file(input: 'Config.vala.in', output: 'Config.vala', configuration: conf)

executable(app_id,
  config_vala,
  'About.vala',
  'AppChoice.vala',
  'Application.vala',
  'AppWindow.vala',
  'Avatar.vala',
  'CallWindow.vala',
  'CallsView.vala',
  'Components.vala',
  'ComposeField.vala',
  'ContactEditor.vala',
  'ContactsView.vala',
  'Daemon.vala',
  'MainWindow.vala',
  'MessagesView.vala',
  'NotificationsView.vala',
  'NowPlayingView.vala',
  'DriveOptions.vala',
  'HeadphonesView.vala',
  'ModuleRow.vala',
  'PairingDialog.vala',
  'QuickReply.vala',
  'SetupParts.vala',
  'Onboarding.vala',
  'ServicesView.vala',
  'Sidebar.vala',
  'PhoneGuide.vala',
  'Guide.vala',
  'Language.vala',
  dependencies: [
    dependency('gio-2.0'),
    dependency('gtk4'),
    dependency('granite-7', version: '>= 7.7'),
  ],
  install: true,
)
